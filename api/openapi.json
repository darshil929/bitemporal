{
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "NotSignedInResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/SessionEnded"
          }
        },
        "required": [
          "detail"
        ],
        "title": "NotSignedInResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "database_schema": {
            "title": "Database Schema",
            "type": "string"
          },
          "expected_migration": {
            "title": "Expected Migration",
            "type": "string"
          },
          "migration": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Migration"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database_schema",
          "migration",
          "expected_migration",
          "reason"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "SessionEnded": {
        "description": "Why the request's session is not running; every field absent where it never was.",
        "properties": {
          "ended_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          },
          "idle_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idle Minutes"
          },
          "max_hours": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Hours"
          },
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "idle",
                  "limit",
                  "signed_out",
                  "signed_out_elsewhere",
                  "disabled"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "reason",
          "ended_at",
          "idle_minutes",
          "max_hours"
        ],
        "title": "SessionEnded",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "must_change_password": {
            "title": "Must Change Password",
            "type": "boolean"
          },
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "title": "Role",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "display_name",
          "role",
          "must_change_password"
        ],
        "title": "SessionResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Bitemporal API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/session": {
      "get": {
        "operationId": "session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotSignedInResponse"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "summary": "Session",
        "tags": [
          "sessions"
        ]
      }
    }
  }
}
