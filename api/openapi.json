{
  "components": {
    "schemas": {
      "FirstAdminRequest": {
        "properties": {
          "display_name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 3,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "display_name",
          "password"
        ],
        "title": "FirstAdminRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "InstrumentNotFound": {
        "properties": {
          "reason": {
            "const": "instrument_not_found",
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "InstrumentNotFound",
        "type": "object"
      },
      "InstrumentNotFoundResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/InstrumentNotFound"
          }
        },
        "required": [
          "detail"
        ],
        "title": "InstrumentNotFoundResponse",
        "type": "object"
      },
      "InstrumentResponse": {
        "description": "An instrument under the names a reader knows it by, with every stretch it was listed for;\n`superseded_by` is the ISIN that took it over at a change of face value, `primary_venue` the\nvenue its pages open on, absent where no daily features were computed for it.",
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "instrument_type": {
            "title": "Instrument Type",
            "type": "string"
          },
          "is_single_listed": {
            "title": "Is Single Listed",
            "type": "boolean"
          },
          "isin": {
            "title": "Isin",
            "type": "string"
          },
          "listings": {
            "items": {
              "$ref": "#/components/schemas/ListingResponse"
            },
            "title": "Listings",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "primary_venue": {
            "anyOf": [
              {
                "enum": [
                  "BSE",
                  "NSE"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Venue"
          },
          "superseded_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Superseded By"
          },
          "venues": {
            "items": {
              "enum": [
                "BSE",
                "NSE"
              ],
              "type": "string"
            },
            "title": "Venues",
            "type": "array"
          }
        },
        "required": [
          "isin",
          "name",
          "display_name",
          "instrument_type",
          "superseded_by",
          "primary_venue",
          "venues",
          "is_single_listed",
          "listings"
        ],
        "title": "InstrumentResponse",
        "type": "object"
      },
      "ListingResponse": {
        "properties": {
          "closure_reason": {
            "anyOf": [
              {
                "enum": [
                  "delisted",
                  "renamed",
                  "merged",
                  "superseded"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Closure Reason"
          },
          "delisting_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delisting Date"
          },
          "exchange": {
            "enum": [
              "BSE",
              "NSE"
            ],
            "title": "Exchange",
            "type": "string"
          },
          "listing_date": {
            "format": "date",
            "title": "Listing Date",
            "type": "string"
          },
          "local_symbol": {
            "title": "Local Symbol",
            "type": "string"
          },
          "scrip_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scrip Code"
          }
        },
        "required": [
          "exchange",
          "local_symbol",
          "scrip_code",
          "listing_date",
          "delisting_date",
          "closure_reason"
        ],
        "title": "ListingResponse",
        "type": "object"
      },
      "MarketDataUpdating": {
        "properties": {
          "reason": {
            "const": "market_data_updating",
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "MarketDataUpdating",
        "type": "object"
      },
      "MarketDataUpdatingResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/MarketDataUpdating"
          }
        },
        "required": [
          "detail"
        ],
        "title": "MarketDataUpdatingResponse",
        "type": "object"
      },
      "MarketDayResponse": {
        "description": "The day the market pages show; every field absent before the first publish of the daily\nfeatures.",
        "properties": {
          "last_complete_day": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Complete Day"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "published_day": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published Day"
          },
          "venues": {
            "items": {
              "$ref": "#/components/schemas/VenueSessionResponse"
            },
            "title": "Venues",
            "type": "array"
          }
        },
        "required": [
          "published_day",
          "published_at",
          "venues",
          "last_complete_day"
        ],
        "title": "MarketDayResponse",
        "type": "object"
      },
      "NewPasswordRequest": {
        "properties": {
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "title": "NewPasswordRequest",
        "type": "object"
      },
      "NotSignedInResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/SessionEnded"
          }
        },
        "required": [
          "detail"
        ],
        "title": "NotSignedInResponse",
        "type": "object"
      },
      "PasswordRefusedResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "PasswordRefusedResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "database_schema": {
            "title": "Database Schema",
            "type": "string"
          },
          "expected_migration": {
            "title": "Expected Migration",
            "type": "string"
          },
          "migration": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Migration"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database_schema",
          "migration",
          "expected_migration",
          "reason"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "SessionEnded": {
        "description": "Why the request's session is not running; every field absent where it never was.",
        "properties": {
          "ended_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          },
          "idle_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idle Minutes"
          },
          "max_hours": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Hours"
          },
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "idle",
                  "limit",
                  "signed_out",
                  "signed_out_elsewhere",
                  "disabled"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "reason",
          "ended_at",
          "idle_minutes",
          "max_hours"
        ],
        "title": "SessionEnded",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "must_change_password": {
            "title": "Must Change Password",
            "type": "boolean"
          },
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "title": "Role",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "display_name",
          "role",
          "must_change_password"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SetupRefusedResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "SetupRefusedResponse",
        "type": "object"
      },
      "SetupResponse": {
        "properties": {
          "admin_exists": {
            "title": "Admin Exists",
            "type": "boolean"
          }
        },
        "required": [
          "admin_exists"
        ],
        "title": "SetupResponse",
        "type": "object"
      },
      "SignInRefused": {
        "description": "Why a sign-in was refused, and until when where it is paused.",
        "properties": {
          "paused_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paused Until"
          },
          "reason": {
            "enum": [
              "wrong_credentials",
              "paused",
              "disabled",
              "temporary_password_expired"
            ],
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason",
          "paused_until"
        ],
        "title": "SignInRefused",
        "type": "object"
      },
      "SignInRefusedResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/SignInRefused"
          }
        },
        "required": [
          "detail"
        ],
        "title": "SignInRefusedResponse",
        "type": "object"
      },
      "SignInRequest": {
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "SignInRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VenueSessionResponse": {
        "properties": {
          "is_complete": {
            "title": "Is Complete",
            "type": "boolean"
          },
          "venue": {
            "enum": [
              "BSE",
              "NSE"
            ],
            "title": "Venue",
            "type": "string"
          }
        },
        "required": [
          "venue",
          "is_complete"
        ],
        "title": "VenueSessionResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Bitemporal API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/password": {
      "post": {
        "description": "Replace the temporary password an admin set with one the person chooses.",
        "operationId": "change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordRefusedResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordRefusedResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Change Password",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/sign-in": {
      "post": {
        "operationId": "sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInRefusedResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sign In",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/sign-out": {
      "post": {
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Sign Out",
        "tags": [
          "auth"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/instruments/{isin}": {
      "get": {
        "operationId": "instrument",
        "parameters": [
          {
            "in": "path",
            "name": "isin",
            "required": true,
            "schema": {
              "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$",
              "title": "Isin",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstrumentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotSignedInResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstrumentNotFoundResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataUpdatingResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Instrument",
        "tags": [
          "instruments"
        ]
      }
    },
    "/market/day": {
      "get": {
        "description": "The day the market pages show, each venue's verdict on it, and the latest day up to it\ncomplete at every venue in session.",
        "operationId": "market_day",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDayResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotSignedInResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataUpdatingResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Market Day",
        "tags": [
          "market"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/session": {
      "get": {
        "operationId": "session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotSignedInResponse"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "summary": "Session",
        "tags": [
          "sessions"
        ]
      }
    },
    "/setup": {
      "get": {
        "operationId": "setup",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Setup",
        "tags": [
          "setup"
        ]
      }
    },
    "/setup/admin": {
      "post": {
        "operationId": "create_first_admin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FirstAdminRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupRefusedResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupRefusedResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Create First Admin",
        "tags": [
          "setup"
        ]
      }
    }
  }
}
